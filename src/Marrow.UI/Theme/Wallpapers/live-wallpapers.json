   "glsl": "// Ocean: nth's own. Deep water seen from below the surface: light falls in shafts from a rippling surface, caustics dance over a sandy floor,\n// particles drift, and a shark glides across the window once a loop, a dark silhouette with a swaying tail that the glass bends as it passes.\n// Palette: 0 the deep, 1 the shallows, 2 the surface light, 3 the sand, 4 the shark, 5 the shafts.\n// Options: x = motion (waves and caustics), y = shark (0 none, 1 close and large).\nconst float T = 40.0;\n\nfloat caustic(vec2 q, float a) {\n  float c = 0.0;\n  for (int i = 0; i < 3; i++) {\n    float f = float(i);\n    vec2 r = q * (2.2 + f * 1.3) + vec2(cos(a + f * 2.1), sin(a * 1.0 + f)) * 0.6;\n    c += abs(sin(r.x + sin(r.y * 1.3 + a)) * sin(r.y + sin(r.x * 1.1 - a)));\n  }\n  return pow(sat(1.0 - c / 1.6), 3.0);\n}\n\nfloat sharkShape(vec2 q, float a) {\n  // body: a tapered ellipse along +x, the head at x > 0\n  float len = 0.62;\n  float x = q.x / len;\n  float sway = 0.06 * sin(a * 6.0 - q.x * 7.0) * smoothstep(0.1, -0.9, x);\n  float y = q.y - sway;\n  float half_ = 0.11 * sqrt(sat(1.0 - x * x)) * (x > 0.0 ? 1.0 - 0.35 * x * x : 1.0 - 0.75 * x * x);\n  float body = smoothstep(u_px * 2.0, -u_px * 2.0, abs(y) - half_) * step(-1.0, x) * step(x, 1.0);\n  // dorsal fin, pectoral fin and the tail fork\n  vec2 d = vec2(q.x + 0.02, y - 0.09);\n  float dorsal = step(0.0, d.y) * step(d.y, 0.13) * step(abs(d.x - d.y * 0.6), 0.07 * (1.0 - d.y / 0.13));\n  vec2 pc = vec2(q.x - 0.1, y + 0.08);\n  float pect = step(pc.y, 0.0) * step(-0.11, pc.y) * step(abs(pc.x + pc.y * 0.9), 0.05 * (1.0 + pc.y / 0.11));\n  vec2 tq = vec2(q.x + len + 0.02, y);\n  float tail = step(-0.15, tq.x) * step(tq.x, 0.0) * step(abs(abs(tq.y) - (-tq.x) * 0.9), 0.035);\n  return sat(max(max(body, dorsal), max(pect, tail)));\n}\n\nvec3 wall(vec2 p, float t) {\n  float a = TAU * t / T;\n  float m = mix(0.3, 1.5, u_opt.x);\n  float sharkAmt = u_opt.y;\n  float depth = sat(0.5 - 0.5 * p.y);\n  vec3 col = mix(u_pal[1], u_pal[0], smoothstep(-0.2, 1.0, depth));\n  // the surface: a bright rippling band at the top\n  float surf = smoothstep(0.55, 1.05, p.y + 0.04 * sin(p.x * 6.0 + a * 2.0) * m + 0.02 * lnoise(vec2(p.x * 2.0, 1.0), a, 0.5));\n  col = mix(col, u_pal[2], surf * 0.7);\n  // light shafts from the surface, swaying\n  vec2 tp = p + tiltD(0.6);\n  float shafts = 0.0;\n  for (int i = 0; i < 4; i++) {\n    float f = float(i);\n    float x0 = -1.3 + f * 0.85 + 0.15 * sin(a + f * 1.7) * m;\n    float w = 0.08 + 0.05 * sin(f * 2.3 + a * 2.0);\n    float s = gauss(tp.x - x0 - (1.0 - tp.y) * 0.25, w) * smoothstep(-1.0, 0.9, tp.y);\n    shafts += s * (0.5 + 0.5 * sin(a * 3.0 + f));\n  }\n  col = mix(col, u_pal[5], sat(shafts * 0.35));\n  // the sandy floor with caustics\n  float floorY = -0.72 + 0.04 * sin(p.x * 3.0 + 1.0);\n  float onFloor = smoothstep(floorY + 0.04, floorY - 0.04, p.y);\n  vec3 sand = u_pal[3];\n  sand.x += 0.12 * caustic(vec2(p.x, p.y * 2.5) + tiltD(-0.8), a * m);\n  col = mix(col, sand, onFloor);\n  col.x += 0.06 * caustic(p * 0.8, a * m) * (1.0 - depth) * (1.0 - onFloor);\n  // drifting particles\n  vec2 g = p * 9.0 + vec2(0.0, a * 0.6);\n  vec2 id = floor(g);\n  vec3 h = hash33(vec3(id, 5.0)) * 0.5 + 0.5;\n  float dot_ = smoothstep(0.08, 0.0, length(fract(g) - h.xy)) * step(0.8, h.z);\n  col.x += dot_ * 0.08;\n  // the shark: crosses once a loop, its depth by the option\n  if (sharkAmt > 0.01) {\n    float scale = mix(0.55, 1.35, sharkAmt);\n    float phase = fract(t / T);\n    vec2 c = vec2(mix(-2.6, 2.6, phase), -0.05 + 0.12 * sin(a));\n    vec2 q = (p - c - tiltD(1.2)) / scale;\n    float s = sharkShape(q, a);\n    vec3 sk = u_pal[4];\n    sk.x += 0.08 * smoothstep(0.0, -0.08, q.y); // a paler belly\n    float haze = mix(0.55, 0.0, sharkAmt);\n    col = mix(col, mix(sk, col, haze), s);\n  }\n  return outLab(col);\n}\n"
  },
