   "glsl": "// Plasma: after shader-effects-inc/shaders' Plasma (MIT, THIRD_PARTY_NOTICES \"shader-effects-inc shaders\"): domain-warped noise on a slab of\n// volume, tone-shaped (a glow, a contrast and a balance) and ramped through two colours, here the pack.\n// Palette: 0 the dark end, 1 to 4 the ramp, 5 the glow.\n// Options: x = warp (how much the flow swirls), y = density.\nconst float T = 50.0;\n\nvec3 wall(vec2 p, float t) {\n  float a = TAU * t / T;\n  float warp = mix(0.0, 1.0, u_opt.x);\n  float density = mix(0.8, 3.6, u_opt.y);\n  vec3 q = vec3(p * density * 0.5 + tiltD(0.5), 0.0);\n  vec3 loop = vec3(cos(a), sin(a), 0.0) * 0.5;\n  vec3 w = vec3(fbm3(q + loop), fbm3(q + vec3(5.2, 1.3, 0.0) - loop), 0.0);\n  float n = fbm3(q + w * 4.0 * warp + loop * 0.5);\n  float v = sat(0.5 + 0.5 * n);\n  v = sat((v - 0.5) * 1.6 + 0.5);\n  v = 1.0 - v;\n  vec3 c = mix(u_pal[0], u_pal[1], smoothstep(0.0, 0.3, v));\n  c = mix(c, u_pal[2], smoothstep(0.25, 0.55, v));\n  c = mix(c, u_pal[3], smoothstep(0.5, 0.8, v));\n  c = mix(c, u_pal[4], smoothstep(0.75, 1.0, v));\n  c.x += 0.08 * pow(v, 4.0) * mix(0.6, 1.0, u_dark);\n  c = mix(c, u_pal[5], 0.15 * pow(v, 6.0));\n  return outLab(c);\n}\n"
  }
