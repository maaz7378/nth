   "glsl": "// Gradient Water: nth's own, its parameters inspired by ruucm/shadergradient (no licence, so its ideas only: a lit water plane seen at an angle deformed by flowing\n// noise, coloured by three colours, with grain). Palette: 0 to 2 the three colours, 3 the shadow, 4 the light, 5 the grain tint.\n// Options: x = strength (how far the noise moves the surface), y = density (its frequency).\nconst float T = 36.0;\n\nvec3 wall(vec2 p, float t) {\n  float a = TAU * t / T;\n  float strength = mix(0.15, 1.6, u_opt.x);\n  float density = mix(0.6, 3.2, u_opt.y);\n  vec2 q = p + tiltD(0.8);\n  float persp = 1.0 / max(0.25, 1.15 - q.y * 0.55);\n  vec2 uv = vec2(q.x * persp, (q.y + 1.2) * persp * 1.4 + 0.2 * sin(q.x * 3.0 + a * 2.0));\n  float shade = 1.0;\n  float mask = 1.0;\n  float h = fbm3(vec3(uv * density, 0.0) + vec3(cos(a), sin(a), 0.0) * 0.6) * strength;\n  float g = sat(0.5 + 0.5 * (uv.y * 0.6 + h));\n  vec3 c = mix(u_pal[0], u_pal[1], smoothstep(0.0, 0.55, g));\n  c = mix(c, u_pal[2], smoothstep(0.45, 1.0, g));\n  float e = 0.02;\n  float hx = fbm3(vec3((uv + vec2(e, 0.0)) * density, 0.0) + vec3(cos(a), sin(a), 0.0) * 0.6) * strength - h;\n  float hy = fbm3(vec3((uv + vec2(0.0, e)) * density, 0.0) + vec3(cos(a), sin(a), 0.0) * 0.6) * strength - h;\n  vec3 nrm = normalize(vec3(-hx / e * 0.15, -hy / e * 0.15, 1.0));\n  float lit = sat(dot(nrm, normalize(vec3(-0.4, 0.6, 0.7))));\n  c.x += (lit - 0.6) * 0.18 * shade;\n  c = mix(c, u_pal[4], pow(lit, 24.0) * 0.25 * shade);\n  vec3 gr = hash33(vec3(floor(p / u_px), 2.0));\n  c.x += gr.x * 0.01;\n  return outLab(c) * mask + outLab(u_pal[3]) * (1.0 - mask);\n}\n"
